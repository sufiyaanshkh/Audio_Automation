# Hugging Face access token. Never commit the real token.
HF_TOKEN=hf_your_token_here

SRAVAANI_MODEL=ARTPARK-IISc/SraVaani-1.0
LID_MODEL=ARTPARK-IISc/Vaani-LID_v0

INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-1B
EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-1B
INDIC_INDIC_MODEL=ai4bharat/indictrans2-indic-indic-1B

# Maximum processing chunk. VAD finds speech regions inside each chunk.
CHUNK_SECONDS=15
LID_MIN_CONFIDENCE=0.45

HOST=127.0.0.1
PORT=5000
DEBUG=false
